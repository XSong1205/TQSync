# TQSync 配置文件模板
# 请复制此文件为 config.yaml 并填入你的真实信息

telegram:
  bot_token: "YOUR_TELEGRAM_BOT_TOKEN"
  group_id: -1001234567890  # 目标 Telegram 群组 ID (负数)
  proxy_url: ""  # 代理地址 (可选, 不使用代理请留空, 以免无法访问导致报错。格式如 http://127.0.0.1:7890)

qq:
  napcat_api_url: "http://127.0.0.1:3000"  # Napcat HTTP API 地址
  access_token: ""  # 如果 Napcat 配置了 Access Token，请在此填写
  group_id: 123456789  # 目标 QQ 群组 ID

server:
  host: "0.0.0.0"
  qq_webhook_port: 8080  # 接收 Napcat Webhook 的端口
  admin_api_port: 8081   # 管理 API 及 Web 面板的端口
  webhook_path: "/webhook/qq"  # Webhook 路径
  webhook_token: ""  # Webhook 鉴权 Token；非空时要求 NapCat 上报携带 Authorization: Bearer <token>，留空则不校验
  admin_api_key: "your_secure_admin_key_here"  # 管理面板 API Key (默认为 Level 1 管理员权限)
  admin_user_ids: []  # 机器人指令管理员 ID 列表 (支持 Telegram User ID 和 QQ User ID)，例如: [123456789, 987654321]

database:
  path: "db/tqsync.db"

sync:
  direction: "both"  # 同步方向: "both"(双向), "tg_to_qq"(仅TG→QQ), "qq_to_tg"(仅QQ→TG)
  sync_notice: true  # 是否启用群公告双向自动感知同步 (默认: true)
  sync_reaction: true  # 是否同步表情回应: TG 表情回应 -> QQ 消息表情点赞 (默认: true)
  face_as_image: true  # 纯表情消息直接发送 QQ 表情原图；设为 false 则统一用 [微笑] 文本 (默认: true)
  worker_count: 3  # 同步工作者并发数 (默认: 3)。高峰可调到 4~8；调大会占用更多带宽与连接
  queue_size: 50  # 待同步队列上限 (默认: 50)。队列满时会丢弃新任务，高峰可适当调大

# 调试配置（可选）
debug:
  sticker_conversion_chat_id: null  # TGS 贴纸转换调试日志发送到的 Telegram Chat ID。启用后也会同步发送到配置的 QQ 群组。测试完成后请设为 null
